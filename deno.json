{
  "exclude": [".momomo", "doc"],
  "lint": {
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  },
  "tasks": {
    "dev": "deno run --allow-all main.ts",
    "test": "deno test --allow-read src/",
    "test:integration": "deno test --allow-read --allow-net --allow-env src/",
    "build:ffi": "cargo build --release --manifest-path ffi/Cargo.toml",
    "compile": "deno task build:ffi && deno compile --allow-ffi --allow-read --allow-write --allow-net --allow-env --include ffi/target/release/libkeyring_ffi.dylib --output denomine-mcp main.ts"
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.2.1",
    "@omochice/redmine": "jsr:@omochice/redmine@^3.0.0",
    "@praha/byethrow": "npm:@praha/byethrow@^0.12.0",
    "@valibot/to-json-schema": "jsr:@valibot/to-json-schema@^1.7.1",
    "@valibot/valibot": "jsr:@valibot/valibot@^1.4.2"
  }
}
