{
  "exclude": [".momomo", "doc"],
  "minimumDependencyAge": {
    "exclude": ["jsr:@omochice/redmine"]
  },
  "fmt": {
    "exclude": ["CHANGELOG.md"],
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  },
  "tasks": {
    "dev": "deno run --allow-all main.ts",
    "test": "deno test --allow-read src/",
    "test:integration": "deno test --allow-read --allow-net --allow-env src/",
    "build:ffi": "cargo build --release --manifest-path ffi/Cargo.toml",
    "compile:bin": "deno run --allow-run=deno task/compile.ts",
    "compile": "deno task build:ffi && deno task compile:bin"
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@1.3.1",
    "@cliffy/prompt": "jsr:@cliffy/prompt@1.3.1",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@1.30.0",
    "@omochice/redmine": "jsr:@omochice/redmine@3.5.1",
    "@praha/byethrow": "npm:@praha/byethrow@0.12.0",
    "@std/expect": "jsr:@std/expect@1.0.20",
    "@std/text": "jsr:@std/text@1.0.19",
    "@valibot/to-json-schema": "jsr:@valibot/to-json-schema@1.8.0",
    "@valibot/valibot": "jsr:@valibot/valibot@1.5.0"
  }
}
